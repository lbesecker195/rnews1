{{- /* layouts/_default/rss.xml snippet */ -}}
{{- $pages := where (where .Site.RegularPages ".Section" "blog") "Kind" "page" -}}
{{- range $pages -}}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <guid>{{ .Permalink }}</guid>
    <description>{{ .Summary | html }}</description>
    {{- with .Params.tweet -}}
    <tweet>{{ . | transform.XMLEscape }}</tweet>
    {{- end -}}
  </item>
{{- end -}}